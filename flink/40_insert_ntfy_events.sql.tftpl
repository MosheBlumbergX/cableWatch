-- ntfy.sh push notification (JSON publish). Anyone subscribed to the topic in the
-- ntfy app gets a phone notification; tapping it opens the vessel on the dashboard.
-- Incidents older than 30 minutes are never sent: restarting a statement replays
-- its input, and nobody should be paged for history.
INSERT INTO `ntfy_events`
SELECT JSON_OBJECT(
  KEY 'topic'    VALUE '${ntfy_topic}',
  KEY 'title'    VALUE `summary`,
  KEY 'message'  VALUE `brief`,
  KEY 'priority' VALUE CASE `action` WHEN 'TRIGGER' THEN 5 WHEN 'WATCH' THEN 3 ELSE 2 END,
  KEY 'tags'     VALUE JSON_ARRAY(CASE `action` WHEN 'TRIGGER' THEN 'rotating_light' WHEN 'WATCH' THEN 'warning' ELSE 'white_check_mark' END),
  KEY 'click'    VALUE CONCAT('${dashboard_url}/?mmsi=', CAST(`mmsi` AS STRING))
)
FROM `${source}`
WHERE `event_time` > CURRENT_TIMESTAMP - INTERVAL '30' MINUTE
  -- Service craft wait over cables as part of their job (notify_service_vessels).
  AND (${include_service} OR COALESCE(`vessel_type`, '') NOT IN ('pilot vessel', 'tug', 'search and rescue vessel', 'law enforcement vessel'));
